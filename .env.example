# GEMINI_API_KEY / ANTHROPIC_API_KEY are intentionally NOT read from .env.
# Just like the Shopify connection, these are entered per-session through the
# app's "Configuración de IA" module, kept in RAM only, and erased when the
# server restarts. There is no env-var fallback for them.

# SESSION_SECRET: encrypts the session cookie (iron-session). Required,
# min 32 chars. Generate one with: openssl rand -base64 32
# On Vercel, set this as a Project Environment Variable.
SESSION_SECRET="MY_32_CHAR_MINIMUM_SESSION_SECRET"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
